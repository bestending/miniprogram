.page {
  padding: 48rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8e;
  line-height: 1.5;
}

.code-input {
  margin-top: 48rpx;
  height: 96rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 36rpx;
  letter-spacing: 8rpx;
  text-align: center;
}

.phone-btn {
  margin-top: 40rpx;
  width: 100%;
}
