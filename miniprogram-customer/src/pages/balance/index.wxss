.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #8a8a8e;
}

.value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.value.primary {
  color: #07c160;
  font-size: 36rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #c8c8cc;
  text-align: center;
}
