.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.card {
  padding: 40rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.label {
  font-size: 26rpx;
  color: #8a8a8e;
}

.amount {
  margin-top: 12rpx;
  font-size: 64rpx;
  font-weight: 700;
  color: #07c160;
}

.tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #c8c8cc;
}

.btn {
  margin-top: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.btn.disabled {
  background: #c8c8cc;
  color: #ffffff;
}
