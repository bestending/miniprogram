.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.header {
  padding: 16rpx 8rpx 32rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 48%;
  margin-bottom: 24rpx;
  padding: 32rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.grid-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: #07c160;
  border-radius: 16rpx;
}

.grid-label {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.grid-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.profile-link {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #1d1d1f;
}

.arrow {
  color: #c8c8cc;
  font-size: 32rpx;
}
