.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.header {
  padding: 16rpx 8rpx 32rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.balance-card {
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 20rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.balance-amount {
  margin-top: 12rpx;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.1;
}

.balance-detail {
  display: flex;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

.detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.detail-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.detail-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.detail-value.code {
  font-family: monospace;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 32rpx;
}

.grid-item {
  width: 48%;
  margin-bottom: 24rpx;
  padding: 32rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.grid-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: #07c160;
  border-radius: 16rpx;
}

.grid-label {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.grid-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.logout {
  margin-top: 16rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #e64340;
}
