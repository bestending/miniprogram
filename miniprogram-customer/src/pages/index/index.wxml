<view class="page">
  <view class="header">
    <view class="header-title">邀请有礼</view>
    <view class="header-sub">顾客编号 · {{shortId}}</view>
  </view>

  <view class="grid">
    <view class="grid-item" bindtap="goInvite">
      <view class="grid-icon primary">码</view>
      <view class="grid-label">我的邀请码</view>
      <view class="grid-sub">邀请好友拿返利</view>
    </view>
    <view class="grid-item" bindtap="goBalance">
      <view class="grid-icon primary">¥</view>
      <view class="grid-label">我的余额</view>
      <view class="grid-sub">可用 / 待定 / 冻结</view>
    </view>
    <view class="grid-item" bindtap="goOrders">
      <view class="grid-icon primary">单</view>
      <view class="grid-label">我的订单</view>
      <view class="grid-sub">查看消费记录</view>
    </view>
    <view class="grid-item" bindtap="goWithdraw">
      <view class="grid-icon primary">提</view>
      <view class="grid-label">申请提现</view>
      <view class="grid-sub">满 150 元可提</view>
    </view>
  </view>

  <view class="profile-link" bindtap="goProfile">
    <text>个人中心</text>
    <text class="arrow">›</text>
  </view>
</view>
