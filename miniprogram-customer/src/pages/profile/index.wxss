.page {
  padding: 48rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.info-card {
  margin-top: 32rpx;
  padding: 8rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f2;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #8a8a8e;
}

.info-value {
  font-size: 28rpx;
  color: #1d1d1f;
}

.info-value.mono {
  font-family: monospace;
  font-size: 24rpx;
}

.tip {
  margin-top: 24rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

.logout-btn {
  margin-top: 48rpx;
  width: 100%;
}
