.page {
  padding: 48rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8e;
  line-height: 1.5;
}

.code-card {
  margin-top: 48rpx;
  padding: 64rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.code-text {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  color: #07c160;
  font-family: monospace;
}

.code-placeholder {
  font-size: 28rpx;
  color: #8a8a8e;
}

.code-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.primary-btn,
.secondary-btn {
  margin-top: 24rpx;
  width: 100%;
}

.secondary-btn {
  background: #f7f8fa;
  color: #1d1d1f;
}
