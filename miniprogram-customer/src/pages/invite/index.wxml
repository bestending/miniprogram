<view class="page">
  <view class="title">我的邀请码</view>
  <view class="sub">把这个码发给好友，对方首次注册即绑定为你的邀请关系</view>

  <view class="code-card">
    <view wx:if="{{loading}}" class="code-placeholder">加载中…</view>
    <view wx:else class="code-text">{{code}}</view>
    <view class="code-hint">点击下方按钮复制或分享</view>
  </view>

  <button class="primary-btn" type="primary" bindtap="onCopy" disabled="{{loading || !code}}">
    复制邀请码
  </button>
  <button class="secondary-btn" open-type="share" disabled="{{loading || !code}}">
    微信好友 / 朋友圈
  </button>
</view>
