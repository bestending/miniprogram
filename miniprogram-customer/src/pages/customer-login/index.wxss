.page {
  padding: 64rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.logo {
  font-size: 56rpx;
  font-weight: 700;
  color: #1d1d1f;
  text-align: center;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a8a8e;
  text-align: center;
}

.form {
  margin-top: 80rpx;
}

.field {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #1d1d1f;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.btn {
  margin-top: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.btn[disabled] {
  background: #9dd9b8;
}

.tip {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #8a8a8e;
  text-align: center;
}
