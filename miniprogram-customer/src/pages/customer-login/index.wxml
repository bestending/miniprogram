<view class="page">
  <view class="logo">邀请有礼</view>
  <view class="subtitle">输入手机号和顾客编号查询返利余额</view>

  <view class="form">
    <view class="field">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="field">
      <text class="label">顾客编号</text>
      <input
        class="input"
        type="number"
        maxlength="4"
        placeholder="4 位数字编号"
        value="{{customerCode}}"
        bindinput="onCodeInput"
      />
    </view>

    <button class="btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">
      登录
    </button>

    <view class="tip">顾客编号由店员首次登记时告知；忘记请联系店员</view>
  </view>
</view>
