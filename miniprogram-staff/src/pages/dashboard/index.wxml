<view class="page">
  <view class="header">
    <view class="header-title">实时看板</view>
    <view class="header-sub">店主编号 · {{shortId}}</view>
  </view>

  <view class="card">
    <view class="card-title">顾客邀请码</view>
    <view class="card-desc">发给新顾客，扫码或输入 6 位码完成注册（长期有效）</view>
    <view wx:if="{{customerInvite}}" class="code-display" bindtap="onCopyCode" data-code="{{customerInvite}}">
      <text class="code-text">{{customerInvite}}</text>
      <text class="code-hint">点击复制</text>
    </view>
    <button
      class="primary-btn"
      type="primary"
      loading="{{generatingCustomer}}"
      disabled="{{generatingCustomer}}"
      bindtap="onGenerateCustomerInvite"
    >
      {{customerInvite ? '再生成一个' : '生成顾客邀请码'}}
    </button>
  </view>

  <view class="card">
    <view class="card-title">店员邀请码</view>
    <view class="card-desc">发给新店员，10 分钟内有效</view>
    <view wx:if="{{staffInvite}}" class="code-display" bindtap="onCopyCode" data-code="{{staffInvite}}">
      <text class="code-text">{{staffInvite}}</text>
      <text class="code-hint">点击复制</text>
    </view>
    <button
      class="secondary-btn"
      type="default"
      loading="{{generatingStaff}}"
      disabled="{{generatingStaff}}"
      bindtap="onGenerateStaffInvite"
    >
      {{staffInvite ? '再生成一个' : '生成店员邀请码'}}
    </button>
  </view>
</view>
