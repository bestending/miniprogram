.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.primary-btn {
  margin-top: 16rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
}

.loading,
.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.item-main {
  margin-bottom: 16rpx;
}

.name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.tag {
  font-size: 22rpx;
  font-weight: 400;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.tag-on {
  background: #e8f7ee;
  color: #07c160;
}

.tag-off {
  background: #f2f2f2;
  color: #8a8a8e;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.rate {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #1d1d1f;
}

.rate-num {
  font-weight: 600;
  color: #fa5151;
}

.item-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.mini-btn {
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  background: #f7f8fa;
  color: #07c160;
  border-radius: 8rpx;
}

.mini-btn.danger {
  color: #fa5151;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal {
  width: 600rpx;
  padding: 40rpx 32rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #1d1d1f;
}

.input {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #1d1d1f;
}

.picker.placeholder {
  color: #c0c0c4;
}

.btn {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-ghost {
  background: #f7f8fa;
  color: #8a8a8e;
}
