.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.loading,
.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.rank {
  width: 80rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #07c160;
  text-align: center;
}

.main {
  flex: 1;
  margin-left: 16rpx;
}

.code {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  font-family: monospace;
}

.count {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #fa5151;
}
