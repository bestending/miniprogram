<view class="page">
  <view class="header">
    <view class="header-title">顾客管理</view>
    <view class="header-sub">录入新顾客 / 查看余额</view>
  </view>

  <button class="primary-btn" bindtap="toggleForm">
    {{showForm ? '收起' : '+ 录入新顾客'}}
  </button>

  <view class="form-card" wx:if="{{showForm}}">
    <view class="field">
      <text class="label">顾客手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="11 位手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <button class="btn" loading="{{creating}}" disabled="{{creating}}" bindtap="onCreateCustomer">
      生成顾客编号
    </button>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <view class="empty" wx:elif="{{customers.length === 0}}">暂无顾客</view>

  <view class="list" wx:else>
    <view class="item" wx:for="{{customers}}" wx:key="customerId">
      <view class="item-main">
        <view class="code">编号 {{item.customerCode}}</view>
        <view class="meta">{{item.roleLabel}} · {{item.createdAtText}}</view>
      </view>
      <button class="mini-btn" data-id="{{item.customerId}}" bindtap="onViewBalance">余额</button>
    </view>
  </view>

  <view class="mask" wx:if="{{balance}}" bindtap="closeBalance">
    <view class="modal" catchtap="">
      <view class="modal-title">顾客余额</view>
      <view class="modal-row">
        <text>可用</text>
        <text class="green">¥{{balance.available}}</text>
      </view>
      <view class="modal-row">
        <text>待定</text>
        <text>¥{{balance.pending}}</text>
      </view>
      <view class="modal-row">
        <text>冻结</text>
        <text>¥{{balance.frozen}}</text>
      </view>
      <button class="btn" bindtap="closeBalance">关闭</button>
    </view>
  </view>
</view>
