.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.card {
  margin-top: 16rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.card-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 1.5;
}

.code-display {
  margin-top: 24rpx;
  padding: 32rpx 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.code-text {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: #07c160;
  font-family: monospace;
}

.code-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.btn {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
