.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #8a8a8e;
}

.filter-item.active {
  background: #07c160;
  color: #ffffff;
}

.loading,
.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.action {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.role {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  background: #f2f2f2;
  color: #8a8a8e;
  border-radius: 8rpx;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.payload {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #6a6a6e;
  word-break: break-all;
  font-family: monospace;
}
