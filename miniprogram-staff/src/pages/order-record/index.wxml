<view class="page">
  <view class="header">
    <view class="header-title">录入订单</view>
    <view class="header-sub">消费后录入，自动计算返利</view>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">订单号</text>
      <input
        class="input"
        placeholder="如 20260918001"
        value="{{orderNo}}"
        data-field="orderNo"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">消费金额（元）</text>
      <input
        class="input"
        type="digit"
        placeholder="如 88.00"
        value="{{amountYuan}}"
        data-field="amountYuan"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">顾客手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="11 位手机号"
        value="{{newbiePhone}}"
        data-field="newbiePhone"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">或顾客编号（4 位）</text>
      <input
        class="input"
        type="number"
        maxlength="4"
        placeholder="手机号已知可留空"
        value="{{newbieCustomerId}}"
        data-field="newbieCustomerId"
        bindinput="onInput"
      />
    </view>

    <button class="btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">
      录入订单
    </button>

    <view class="result" wx:if="{{lastResult}}">{{lastResult}}</view>
  </view>

  <view class="divider">
    <text class="divider-text">批量导入</text>
  </view>

  <view class="import-section">
    <view class="import-desc">上传美团收银机导出的 Excel（.xlsx/.xls/.csv），自动识别「订单号/实付金额/手机号/支付时间」列</view>
    <button class="btn btn-outline" loading="{{importing}}" disabled="{{importing}}" bindtap="onImportExcel">
      {{importing ? '导入中…' : '选择 Excel 文件'}}
    </button>

    <view class="import-result" wx:if="{{importResult}}">
      <view class="result-summary">
        共 {{importResult.total}} 条：成功 <text class="ok">{{importResult.success}}</text> / 失败 <text class="fail">{{importResult.failed}}</text>
      </view>
      <view class="result-list">
        <view class="result-item" wx:for="{{importResult.results}}" wx:key="orderNo">
          <text class="r-order">{{item.orderNo}}</text>
          <text wx:if="{{item.ok}}" class="r-ok">成功 +¥{{item.rebateAmount ? (item.rebateAmount/100).toFixed(2) : '0.00'}}</text>
          <text wx:else class="r-fail">失败：{{item.message}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
