.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.form {
  margin-top: 16rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #1d1d1f;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.btn {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.btn[disabled] {
  background: #9dd9b8;
}

.result {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #07c160;
  text-align: center;
}
